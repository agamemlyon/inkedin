  "structures": [
    {"id": "ce-nest-pas", "regex": "(?i)\\b(?:ce|ça|c')\\s*n'?(?:est|était) pas (?:juste |seulement |qu'?)?[^.!?\\n]{2,70}[,.;:] ?(?:c'est|c'était|mais)\\b", "name": "« Ce n'est pas X, c'est Y »", "fix": "Dis Y directement. Le retournement est la signature LLM n°1 en français."},
    {"id": "il-ne-sagit-pas", "regex": "(?i)\\bil ne s'agit pas (?:de|d')[^.!?\\n]{2,70}\\bmais\\b", "name": "« Il ne s'agit pas de X mais de Y »", "fix": "Commence par Y."},
    {"id": "non-seulement", "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b", "name": "« Non seulement X mais aussi Y »", "fix": "Deux phrases, ou garde la plus forte."},
    {"id": "le-sujet-nest-pas", "regex": "(?i)\\ble (?:sujet|problème|vrai sujet|vrai problème) n'est pas [^.!?\\n]{2,70}[.!] ?le (?:sujet|problème|vrai sujet)", "name": "« Le sujet n'est pas X. Le sujet, c'est Y »", "fix": "Pose Y, puis prouve-le."},
    {"id": "question-reveal", "regex": "(?im)^\\s*(?:le résultat|la clé|le secret|la raison|le problème|la vérité|ma réponse|pourquoi|la leçon|le hic|spoiler)\\s*\\?\\s*$", "name": "Ligne-question de révélation (« Le résultat ? »)", "fix": "Fonds la réponse dans la phrase précédente."},
    {"id": "conclusion-label", "regex": "(?im)^\\s*(?:conclusion|en conclusion|en résumé|à retenir|takeaway|morale)\\s*:", "name": "Étiquette « Conclusion : »", "fix": "Termine sur l'idée, pas sur l'étiquette."},
    {"id": "et-si", "regex": "(?im)^\\s*et si\\b[^\\n]{0,80}\\?", "name": "Ouverture « Et si… ? »", "fix": "Affirme ce que tu proposes."},
    {"id": "imaginez", "regex": "(?im)^\\s*imagine[zs]?\\b", "name": "Ouverture « Imaginez… »", "fix": "Raconte une scène réelle à la place."},
    {"id": "plutot-que", "regex": "(?i)\\(plutôt que [^)]{2,40}\\)", "name": "Parenthèse « (plutôt que X) » en série", "fix": "Une seule opposition par post suffit."},
    {"id": "fleche-cta", "regex": "\\U0001F447", "name": "Emoji 👇 d'appel à commentaire", "fix": "Pose une vraie question spécifique ou rien."},
    {"id": "bold-header-list", "regex": "(?m)^\\s*(?:[-*]|\\S{1,3})\\s*[^\\n:]{2,40}\\s?:\\s*\\n", "name": "Liste à titres en gras « Titre : »", "fix": "Écris l'item comme une phrase."}
  ]
}
