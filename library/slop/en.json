 "structures": [
  {
   "id": "not-just",
   "regex": "(?i)\\bit'?s not (?:just|only|merely) [^.!?\\n]{2,60}[,.;] ?it'?s\\b",
   "name": "\"It's not just X, it's Y\"",
   "fix": "Say Y. Delete the setup."
  },
  {
   "id": "not-only",
   "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut (?:also)?\\b",
   "name": "\"Not only X but also Y\"",
   "fix": "Two sentences or drop the weaker half."
  },
  {
   "id": "isnt-about",
   "regex": "(?i)\\b(?:this|it) (?:is|was)(?:n'?t| not) about [^.!?\\n]{2,60}[.!,;] ?it'?s about\\b",
   "name": "\"It isn't about X. It's about Y.\"",
   "fix": "Lead with Y."
  },
  {
   "id": "one-word-q",
   "regex": "(?m)^\\s*(?:The (?:result|kicker|secret|truth|catch|lesson|twist)|Why|The answer|My take)\\s*\\?\\s*$",
   "name": "Staged reveal question line",
   "fix": "Merge the answer into the previous sentence."
  },
  {
   "id": "heres-why",
   "regex": "(?im)^\\s*here'?s (?:why|how|what)\\b.*[:.]?\\s*$",
   "name": "\"Here's why:\" signpost",
   "fix": "Cut it. Start with the reason."
  },
  {
   "id": "conclusion-label",
   "regex": "(?im)^\\s*(?:in conclusion|conclusion|key takeaways?|tl;dr)\\s*[:\\-]",
   "name": "Conclusion label",
   "fix": "End on the point itself."
  },
  {
   "id": "bold-header-list",
   "regex": "(?m)^\\s*(?:[-*•]|\\d+[.)]|[0-9]\\ufe0f?\\u20e3|[\\U0001F300-\\U0001FAFF\\u2705\\u2714])\\s*\\*{0,2}[A-ZÀ-Ö][^\\n:]{1,30}\\*{0,2}\\s?:\\s+\\S",
   "name": "Inline-header list item",
   "fix": "Write the item as a sentence."
  }
 ]
